import numpy as np
import pandas as pd

def backtest_btc_regime_sign_overlay(
    prices: pd.DataFrame,
    lead_lag_matrix_rolling: pd.DataFrame,
    dir_signal: pd.Series,                  # 日度 0/1/2（熊/中/牛）
    *,
    btc_col: str = "BTC",
    orientation: str = "row",               # "row": 用 M.loc[BTC] ；"col": 用 M[BTC]
    quantile: float = 0.2,                  # 用于挑 leaders/followers 的分位
    min_names: int = 3,
    use_log_returns: bool = True,

    # overlay 细节
    apply_to_leaders: bool = True,          # True=对 leaders 也按符号做多空；False=仅 followers
    preserve_baseline_hedge: bool = False,  # True=始终把 leaders 加入 short 侧（保持原对冲）
    neutral_scale: float = 0.5,             # 中性期缩仓；设 0 表示不交易

    # 强度过滤：只保留 |BTC→asset| 足够大的名字
    abs_rel_quantile: float | None = 0.5,   # 如 0.5 表示只保留当日 |rel| ≥ 当日分布中位数；None=不做
) -> pd.Series:
    """
    逻辑：
      1) 当天用 lead–lag 矩阵打分，按 quantile 选出 followers(负尾) / leaders(正尾)。
      2) 取当日 BTC→asset 的“带符号”关系（由矩阵的正负给出）：
         - 牛(2)：followers 中 rel>0 → long；rel<0 → short；leaders 同理（可开关 apply_to_leaders）
         - 熊(0)：把上面多空对调（flip）
         - 中(1)：按 neutral_scale 缩仓（=0 表示不交易）
      3) （可选）若 preserve_baseline_hedge=True，则无论如何把 leaders 也加入 short 侧，维持对冲骨架。
      4) 严格落到 “下一交易日” 计算 PnL。
    返回：仅交易日的收益序列（名称：'btc_regime_sign'）。
    """
    # ---------- 索引与收益 ----------
    px = prices.copy()
    px.index = pd.to_datetime(px.index).tz_localize(None)
    px = px.sort_index()
    rets = (np.log(px).diff() if use_log_returns else px.pct_change()).dropna(how="all")
    rets.index = pd.to_datetime(rets.index).tz_localize(None)
    rets = rets.sort_index()
    r_idx = rets.index
    if btc_col not in rets.columns:
        raise KeyError(f"'{btc_col}' 不在 prices/returns 的列中，现有列：{list(rets.columns)[:5]}...")

    def _next_trading_day(d: pd.Timestamp, step: int = 1):
        pos = r_idx.searchsorted(pd.Timestamp(d), side="right")
        pos = pos + (step - 1)
        return None if pos >= len(r_idx) else r_idx[pos]

    # ---------- 矩阵时间轴 ----------
    L = lead_lag_matrix_rolling.copy()
    L.index = pd.to_datetime(L.index).tz_localize(None)
    L = L.sort_index()
    L = L[~L.index.duplicated(keep="last")]

    # ---------- regime 日序列 ----------
    ds = pd.Series(dir_signal).copy()
    ds.index = pd.to_datetime(ds.index).tz_localize(None).normalize()
    ds = ds.sort_index()
    ds = ds[~ds.index.duplicated(keep="last")]

    out, dates = [], []

    for d in L.index:
        # 找下一交易日（提前做，便于跳过末尾）
        next_day = _next_trading_day(d, step=1)
        if next_day is None:
            continue
        r_next = rets.loc[next_day]

        # 当日 BTC regime（asof 对齐）
        z = ds.asof(pd.Timestamp(d)) if len(ds) else pd.NA
        if pd.isna(z):
            continue
        z = int(z)

        # 中性期缩仓/不交易
        if z == 1 and neutral_scale == 0.0:
            continue

        # 取当日矩阵 & 资产打分（用于挑 leaders/followers）
        M = L.loc[d]
        if isinstance(M, pd.Series):
            # 若存的是向量而不是方阵，则直接用该向量做打分（无法区分 leaders/followers）
            s_scores = pd.Series(M).dropna()
        else:
            if M.isnull().all().all():
                continue
            s_scores = M.mean(axis=1).astype(float)

        # 选 leaders / followers（与原 baseline 一致：正尾=leaders，负尾=followers）
        pos_scores = s_scores[s_scores > 0]
        neg_scores = s_scores[s_scores < 0]
        if len(pos_scores) == 0 or len(neg_scores) == 0:
            continue
        hi = pos_scores.quantile(1 - quantile)
        lo = neg_scores.quantile(quantile)
        leaders   = s_scores[s_scores >= hi].index
        followers = s_scores[s_scores <= lo].index

        # 取 BTC→asset 的“带符号关系”向量（按你的矩阵定义：正=同向，负=反向）
        if isinstance(M, pd.DataFrame):
            if orientation == "row":
                rel = M.loc[btc_col].astype(float, errors="ignore")
            elif orientation == "col":
                rel = M[btc_col].astype(float, errors="ignore")
            else:
                raise ValueError("orientation 只能是 'row' 或 'col'")
        else:
            # 无法从 Series 推出 BTC→asset 关系
            continue

        # 与可交易资产求交集
        universe = list(set(r_next.index) & set(rel.index))
        if not universe:
            continue
        rel = rel.loc[universe]

        # （可选）强度过滤：只保留 |rel| 足够大的名字
        if abs_rel_quantile is not None:
            thr = rel.abs().quantile(abs_rel_quantile)
            rel = rel[rel.abs() >= thr]
            if rel.empty:
                continue

        # 在 followers / leaders 中做符号分类
        def split_by_sign(names, flip: bool):
            names = [n for n in names if n in rel.index]
            if not names:
                return [], []
            if not flip:
                long_names  = [n for n in names if rel[n] > 0]
                short_names = [n for n in names if rel[n] < 0]
            else:
                long_names  = [n for n in names if rel[n] < 0]
                short_names = [n for n in names if rel[n] > 0]
            return long_names, short_names

        flip = (z == 0)  # 熊市翻转；牛市不翻；中性靠缩仓
        long_set, short_set = set(), set()

        # followers：按符号分多空（核心）
        Lf, Sf = split_by_sign(followers, flip=flip)
        long_set.update(Lf); short_set.update(Sf)

        # leaders：是否也按符号分多空
        if apply_to_leaders:
            Ll, Sl = split_by_sign(leaders, flip=flip)
            long_set.update(Ll); short_set.update(Sl)

        # 可选：保留 baseline 的“空 leaders 对冲”
        if preserve_baseline_hedge:
            short_set.update([n for n in leaders if n in r_next.index])

        # 数量门槛
        if len(long_set) < min_names or len(short_set) < min_names:
            continue

        # 计算当日 PnL（严格下一交易日）
        long_ret  = r_next[list(long_set)].dropna().mean() if len(long_set)  else 0.0
        short_ret = r_next[list(short_set)].dropna().mean() if len(short_set) else 0.0
        pnl = long_ret - short_ret

        # 中性缩仓
        if z == 1 and 0.0 < neutral_scale < 1.0:
            pnl *= float(neutral_scale)

        out.append(pnl)
        dates.append(next_day)

    return pd.Series(out, index=dates, name="btc_regime_sign")


import pandas as pd
from pathlib import Path

def read_daily_dir_signal_csv(path, date_col=None, label_col="dir_label"):
    df = pd.read_csv(path)
    if date_col is None:
        # 自动找日期列：不是 dir_label 的那一列
        if label_col in df.columns and len(df.columns) == 2:
            date_col = [c for c in df.columns if c != label_col][0]
        else:
            date_col = df.columns[0]  # 兜底
    df[date_col] = pd.to_datetime(df[date_col]).dt.normalize()
    s = df.set_index(date_col)[label_col].astype("Int64").sort_index()
    return s[~s.index.duplicated(keep="last")]  # Series: 日期→{0,1,2}

def evaluate_strategy(returns, risk_free_rate=0):
    ann_factor = 252
    excess_ret = returns - risk_free_rate / ann_factor

    sharpe = excess_ret.mean() / excess_ret.std() * np.sqrt(ann_factor)
    volatility = returns.std() * np.sqrt(ann_factor)
    cumulative_return = (1 + returns).cumprod() - 1
    max_drawdown = (cumulative_return - cumulative_return.cummax()).min()
    annual_return = (1 + cumulative_return[-1]) ** (ann_factor / len(returns)) - 1

    stats = {
        'Annual Return (%)': annual_return * 100,
        'Sharpe Ratio': sharpe,
        'Volatility (%)': volatility * 100,
        'Max Drawdown (%)': max_drawdown * 100,
    }
    return stats

