    prices=prices,
    lead_lag_matrix_rolling=lead_lag_sig,
    dir_signal=dir_signal,
    btc_col="BTC",
    orientation="row",       # 如果你的矩阵是“列→行”，就改成 "col"
    quantile=0.1,
    min_names=3,
    use_log_returns=True,
    apply_to_leaders=True,   # 符合你“对 lead 也如此”的要求
