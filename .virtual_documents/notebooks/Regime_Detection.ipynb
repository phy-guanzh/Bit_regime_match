        #label_names={0:"Bear", 1:"Sideways", 2:"Bull"},
        label_names={0:"Cluster 0 ", 1:"Cluster 1", 2:"Cluster 2"},
        title=f"steps={n_steps_i}, paths={n_paths_i}, offset={offset_i} (H={H_i}, k={k_vote}, train_end={train_end.date()})"
    )
    fig = plt.gcf()
    #fig.show()
    
    plt.close(fig)

    #Save trading signals into signals/ folder
    df_sig.to_csv(signals_dir / f"wf_signal_{key}.csv", index=False)             # Group-level labels
    spans.to_csv  (signals_dir / f"spans_dir_{key}_k{k_vote}.csv", index=False) # Interval-level labels
