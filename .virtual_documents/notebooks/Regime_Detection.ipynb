    print(f"✓ done {key}: groups={D.shape[0]}, train_end={train_end.date()}")



def plot_ari_heatmap(ari: pd.DataFrame):
    fig, ax = plt.subplots(figsize=(8, 6))
    im = ax.imshow(ari.values.astype(float), vmin=0, vmax=1, cmap="viridis")
    ax.set_xticks(range(len(ari.columns)))
    ax.set_yticks(range(len(ari.index)))
    ax.set_xticklabels(ari.columns, rotation=45, ha="right", fontsize=8)
    ax.set_yticklabels(ari.index, fontsize=8)
    cbar = fig.colorbar(im, ax=ax, label="ARI")
    ax.set_title("Adjusted Rand Index between configurations")
    plt.tight_layout()
    plt.show()

plot_ari_heatmap(ari)



def plot_summary_bars(summary: pd.DataFrame):
    srt = summary.sort_values(["steps","paths"])
    x = np.arange(len(srt["key"]))
    fig, axes = plt.subplots(3, 1, figsize=(10, 9), sharex=True)

    
    axes[0].bar(x, srt["cover_days"])
    axes[0].set_ylabel("Cover days")
    axes[0].set_title("Coverage by configuration")

    
    axes[1].bar(x, srt["switches"])
    axes[1].set_ylabel("Switches")
    axes[1].set_title("Number of regime switches")

    
    b0 = srt["pct_cluster0"].fillna(0).values
    b1 = srt["pct_cluster1"].fillna(0).values
    b2 = srt["pct_cluster2"].fillna(0).values
    axes[2].bar(x, b0, label="Cluster 0")
    axes[2].bar(x, b1, bottom=b0, label="Cluster 1")
    axes[2].bar(x, b2, bottom=b0+b1, label="Cluster 2")
    axes[2].set_ylabel("Proportion")
    axes[2].set_ylim(0, 1)
    axes[2].legend(ncol=3)

    axes[-1].set_xticks(x)
    axes[-1].set_xticklabels(srt["key"], rotation=45, ha="right", fontsize=8)
    plt.tight_layout()
    plt.show()

plot_summary_bars(summary)



from sklearn.manifold import MDS

def plot_and_save(D, labels, save_path, title="Trajectory Clusters (MDS Projection)"):
    """Plot clusters in MDS 2D space and save to a file."""
    emb = mds_embed(D)
    plt.figure(figsize=(8, 6))
    for c in np.unique(labels.astype(int)):
        idx = (labels == c)
        plt.scatter(emb[idx, 0], emb[idx, 1], s=18, label=f"Cluster {c+1}")
    plt.title(title)
    plt.xlabel("MDS-1"); plt.ylabel("MDS-2")
    plt.legend(); plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()
    plt.savefig(save_path, dpi=200)   # save as PNG
    plt.close()
    print(f"✓ Saved figure: {save_path}")

