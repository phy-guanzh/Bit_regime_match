pat = re.compile(r"pairwise_distance_matrix_steps(\d+)_paths(\d+)_offset(\d+)\.npy$")

files = sorted(data_dir.glob("pairwise_distance_matrix_steps*_paths*_offset*.npy"))
for f in tqdm(files, desc="Process all settings"):
    # Parse (steps, paths, offset)
    meta_path = f.with_suffix(".meta.json")
    if meta_path.exists():
        with open(meta_path, "r") as fh:
            m = json.load(fh)
        n_steps_i = int(m["n_steps"]); n_paths_i = int(m["n_paths"]); offset_i = int(m["offset"])
    else:
        m = pat.search(f.name)
        if not m:
            print(f"Skip {f.name}: cannot parse params")
            continue
        n_steps_i, n_paths_i, offset_i = map(int, m.groups())

    if offset_i != offset_fix:
        continue

    # H can be fixed or follow steps
    H_i = 30  # or: int(n_steps_i)

    # Load distance matrix & generate consistent time ranges
    D = np.load(f)
    sub_paths_all = get_sub_paths(trajectory_data, n_steps=n_steps_i, offset=offset_i)
    df_ranges = time_ranges_from_subpaths(sub_paths_all, n_paths=n_paths_i)
    if len(df_ranges) != D.shape[0]:
        print(f"SKIP {f.name}: groups mismatch ({len(df_ranges)} vs {D.shape[0]})")
        continue

    # Define global semantics during training period + prototype assignment
    train_end = pd.to_datetime(df_ranges["end_time"]).quantile(0.7)
    medoids, proto2cluster, mapping = fit_prototypes_and_mapping(
        D, df_ranges, price_series,
        train_end=train_end, n_clusters=n_clusters, H=H_i,
        min_count=10, tau_pos=0.0, tau_neg=0.0
    )
    cluster_id_all, dir_all = assign_by_prototypes(D, medoids, proto2cluster, mapping)
    df_sig = df_ranges.assign(cluster_id=cluster_id_all, dir_label=dir_all)

    # Daily rolling vote (vote on dir_label)
    df_for_vote = df_sig.rename(columns={"dir_label": "cluster"})
    spans = compress_with_rolling_vote(df_for_vote, k=k_vote)  # start/end/cluster
    spans_plot = spans.rename(columns={"start": "start_time", "end": "end_time"})

    # Plot + save PNG (without overwrite)
    key = f"s{n_steps_i}_p{n_paths_i}_o{offset_i}_H{H_i}_proto"
    plot_price_with_cluster_background(
        price_series=price_series,
        df_clusters=spans_plot.assign(dir_label=spans_plot["cluster"]),
